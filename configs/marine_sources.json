{
  "schema_version": 1,
  "status": "PUBLIC_PRODUCT_SCHEMA - LOCAL FILES REQUIRED",
  "sources": {
    "ERA5": {
      "variables": ["u10", "v10"],
      "meaning": "10 m eastward and northward wind components",
      "official_documentation": "https://cds.climate.copernicus.eu/datasets/reanalysis-era5-single-levels"
    },
    "Copernicus WAVERYS": {
      "variables": ["VHM0", "VTPK", "VMDR"],
      "direction_input": "wave from direction",
      "direction_output": "direction of travel = (VMDR + 180) mod 360",
      "official_documentation": "https://help.marine.copernicus.eu/en/articles/6175153-how-to-describe-wave-height-period-and-direction-parameters"
    },
    "Copernicus GLORYS": {
      "variables": ["uo", "vo"],
      "meaning": "surface eastward and northward current components",
      "official_documentation": "https://help.marine.copernicus.eu/en/articles/5046685-which-is-the-direction-conventions-of-currents-wave-and-wind-for-copernicus-marine-products"
    },
    "GEBCO": {
      "variables": ["elevation"],
      "conversion": "negative elevation becomes positive water_depth; land is excluded",
      "official_documentation": "https://www.gebco.net/data_and_products/gridded_bathymetry_data/"
    }
  }
}
